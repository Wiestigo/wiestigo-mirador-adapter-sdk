<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wiestigo.mirador</groupId>
        <artifactId>rmm_adapter_sdk</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>rmm_remote_service_template</artifactId>
    <packaging>jar</packaging>

    <name>rmm_remote_service_template</name>
    <description>
        Template of a remote adapter service for protocol version 4: Java 17 and only the
        JDK. An HttpsServer that requires a client certificate, the pinned certificates of
        the connections, X-RMM-Binding checked against the certificate, and the version 4
        endpoints backed by an in-memory tool per binding. Tests itself with the TCK for
        remote services (rmm_remote_tck) in the reactor. Guide for the operator: README.md.
    </description>

    <!-- The template is MIT-0 (LICENSE), not the Apache-2.0 of the parent. Put your own license here. -->
    <licenses>
        <license>
            <name>MIT-0</name>
            <url>https://opensource.org/license/mit-0</url>
        </license>
    </licenses>

    <!--
        The main code has NO dependency: only the JDK (com.sun.net.httpserver,
        javax.net.ssl, java.security). The dependencies below are for the tests only.
    -->
    <dependencies>
        <!-- The TCK for remote services: RemoteServiceContractTest (brings Jackson) -->
        <dependency>
            <groupId>com.wiestigo.mirador</groupId>
            <artifactId>rmm_remote_tck</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The jar of the template carries the template's own license (MIT-0), not the SDK's -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
    </build>
</project>
