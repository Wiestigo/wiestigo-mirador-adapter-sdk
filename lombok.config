# Lombok configuration for all modules (Lombok searches upward from the source file).
config.stopBubbling = true

# @Jacksonized generates the annotations for Jackson 3 (tools.jackson.databind), which all
# code uses. Jackson 2 can still be on the class path through libraries; without this
# setting Lombok would then choose Jackson 2 and warn.
lombok.jacksonized.jacksonVersion += 3
